    <import file="build-jars.xml" as="${co.prj.os}-${co.prj.os.arch}"/>

    <property environment="env"/>
    <property name="MYRPM_BUILDROOT" value="${env.MYRPM_BUILDROOT}"/>
    <property name="rpm-build-root.dir" value="${MYRPM_BUILDROOT}"/>
    
    <target name="pre-rpm-build-install" depends="DO-lib" description="compile and install into ${rpm-build-root.dir}/usr/share/games/${co.prj}">
        <copy overwrite="true" file="${resources.props.all.dir}/run" tofile="${rpm-build-root.dir}/usr/games/${co.prj}">
            <filterset refid="filtertokens"/>
        </copy>
        <exec dir="${dist}" executable="chmod">
            <arg line="a+x '${rpm-build-root.dir}/usr/games/${co.prj}'"/>
        </exec>
        <mkdir dir="${rpm-build-root.dir}/usr/share/games/${co.prj}"/>
        <copy overwrite="true" todir="${rpm-build-root.dir}/usr/share/games/${co.prj}">
            <fileset refid="resources.os.all.jars"/>
            <fileset refid="resources.all.jars"/>
            <fileset refid="installed.files"/>
        </copy>
    </target>
    
    <property name="deb-build-root.dir" location="/usr/src/packages/BUILD/debian/${co.prj}"/>
    
    <target name="pre-deb-build-install" depends="DO-lib" description="compile and install into ${deb-build-root.dir}/usr/share/games/${co.prj}">
        <copy overwrite="true" file="${resources.props.all.dir}/run" tofile="${deb-build-root.dir}/usr/games/${co.prj}">
            <filterset refid="filtertokens"/>
        </copy>
        <exec dir="${dist}" executable="chmod">
            <arg line="a+x '${deb-build-root.dir}/usr/games/${co.prj}'"/>
        </exec>
        <mkdir dir="${deb-build-root.dir}/usr/share/games/${co.prj}"/>
        <copy overwrite="true" todir="${deb-build-root.dir}/usr/share/games/${co.prj}">
            <fileset refid="resources.os.all.jars"/>
            <fileset refid="resources.all.jars"/>
            <fileset refid="installed.files"/>
        </copy>
    </target>

    <target name="build-executable" depends="jar" description="build application executable">
        <copy overwrite="true" file="${resources.os.all.dir}/run" tofile="${dist}/${co.prj.os.ei.appName}">
            <filterset refid="filtertokens"/>
        </copy>
    </target>
    <target name="post-jar" depends="build-executable" description="zip application installer executable">
        <zip destfile="${dist}/setup.zip">
            <fileset dir="${dist}">
                <include name="${co.prj.os.ei.appName}"/>
            </fileset>
        </zip>
    </target>
    <target name="install" depends="DO-lib" description="compile and install into /usr/share/games/${co.prj}">
        <copy overwrite="true" file="${resources.props.all.dir}/run" tofile="/usr/games/${co.prj}">
            <filterset refid="filtertokens"/>
        </copy>
        <exec dir="${dist}" executable="chmod">
            <arg line="a+x '/usr/games/${co.prj}'"/>
        </exec>
        <mkdir dir="/usr/share/games/${co.prj}"/>
        <copy overwrite="true" todir="/usr/share/games/${co.prj}">
            <fileset refid="resources.os.all.jars"/>
            <fileset refid="resources.all.jars"/>
            <fileset refid="installed.files"/>
        </copy>

    </target>
    
    
</project>
