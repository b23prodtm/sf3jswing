    <!--  specify the native libraries to install
    syntax is : nativeName:resourcePathToLibraryFile{:load}
    load is default to false which will not call System.load()
    seperate with " " (one blank space) /-->
    <property name="co.prj.os.ei.extNatives" value="clib_jiio:/libclib_jiio.so mlib_jai:/libmlib_jai.so openal:/libopenal.so jinput-linux:/libjinput-linux.so lwjgl:/liblwjgl.so tray:/libtray.so jdic:/libjdic.so jmcvid:/libjmcvid.so jmdaud:/libjmdaud.so jmfjawt:/libjmfjawt.so jmg723:/libjmg723.so jmgsm:/libjmgsm.so jmh261:/libjmh261.so jmh263enc:/libjmh263enc.so jmjpeg:/libjmjpeg.so jmmpa:/libjmmpa.so jmmpegv:/libjmmpegv.so jmmpx:/libjmmpx.so jmutil:/libjmutil.so jmv4l:/libjmv4l.so jmxlib:/libjmxlib.so"/>
