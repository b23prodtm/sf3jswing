    <import file="build-jars.xml" as="${co.prj.os}-${co.prj.os.arch}"/>

    <target name="install" depends="jar" description="create .exe executable">        
        <property name="dist.os.rel" location="${dist.os}/release"/>       
        <mkdir dir="${dist.os.rel}/${os.arch}/jre"/>
        <!-- .lap configuration files (jvm) -->
        <copy overwrite="true" todir="${dist.os.rel}">
            <mapper type="regexp" from="Janel(.*)$$" to="${co.prj}\1"/>
            <fileset dir="${resources.os.all.dir}" includes="Janel*.lap"/>
            <fileset dir="${resources.os.arch.dir}" includes="Janel*.lap*"/>
            <filterset refid="filtertokens"/>
        </copy>        
        <!-- exe files -->
        <copy overwrite="true" todir="${dist.os.rel}">
            <mapper type="regexp" from="Janel(.*)$$" to="${co.prj}\1"/>
            <fileset dir="${resources.os.all.dir}" includes="Janel*.exe"/>
            <fileset dir="${resources.os.arch.dir}" includes="Janel*.exe"/>
        </copy>        
        <!-- .jar files -->
        <move overwrite="true" todir="${dist.os.rel}">
            <fileset dir="${dist}" includes="**/*.jar"/>
        </move>        
        <!-- Java Runtime -->        
        <copy todir="${dist.os.rel}/${os.arch}/jre">
            <fileset dir="${java.home}">
                <include name="**/*"/>
            </fileset>
        </copy>
    </target>
