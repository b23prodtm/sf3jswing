            </ide-actions>
            <export>
                <type>folder</type>
                <location>dist/Windows/applet</location>
                <build-target>compile</build-target>
            </export>
            <view>
                <items>
                    <source-folder style="packages">
                        <label>src\all</label>
                        <location>src/all</location>
                    </source-folder>
                    <source-folder style="packages">
                        <label>src\Windows</label>
                        <location>src/Windows</location>
                    </source-folder>
                    <source-folder style="packages">
                        <label>resources\properties</label>
                        <location>resources/properties</location>
                    </source-folder>
                    <source-file>
