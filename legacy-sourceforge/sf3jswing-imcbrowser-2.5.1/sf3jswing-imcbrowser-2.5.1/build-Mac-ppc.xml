        <!-- BUILD APPLICATION PACKAGE /-->
    
        <property name="application" location="${dist}/${co.prj}.app"/>
        <property name="application.macos" location="${application}/Contents/MacOS"/>
        <property name="application.macos.stub" location="${application.macos}/${co.prj}"/>
        <property name="application.resources" location="${application}/Contents/Resources"/>
        <property name="application.resources.java" location="${application}/Contents/Resources/Java"/>
   
        <taskdef name="bundleapp"
             classname="com.oracle.appbundler.AppBundlerTask"   
             classpath="lib/appbundler-1.0ea.jar" /> 
        <property name="java_home" value="${java.home}/.."/>

        <target name="install" depends="clean, jar" description="create application .app package">
                <property name="approotcp" value="$APP_ROOT/Contents/Java/"/>
        
                <bundleapp 
                        outputdirectory="${dist}"
                        name="IMCBrowser"
                        displayname="Image Multi-Converter and Browser ${co.prj.version.spec}"
                        identifier="${co.prj.bin}"
                        mainclassname="${co.prj.os.app.run.main}"
                        icon="${resources.os.all.dir}/${co.prj}.icns"
                        shortversion="${co.prj.version.impl}"
                        version="${co.prj.version.spec}"
                        signature="IMCB"
                        copyright="${co.prj.years} ${company}"
                        executableName="${co.prj}"
                        applicationCategory="public.app-category.photography">

                        <runtime dir="${java_home}" />
                        <!-- copies the .jar to .app/Contents/Java-->
                        <classpath dir="${dist}">
                                <include name="*.jar"/>
                                <include name="api/*.jar"/>
                        </classpath>
                        <!-- runtime classpath with no folder hierarchy /-->
                        <option value="-Djava.class.path=${approotcp}${co.prj.os.kernel.jar}:${approotcp}esell-validation-${co.prj.os}-${co.prj.os.arch}-ext_signed.jar:${approotcp}esell-validation-${co.prj.os}-${co.prj.os.arch}-ext-native_signed.jar:${approotcp}mail_signed.jar:${approotcp}${co.prj}-${co.prj.os}-${co.prj.os.arch}_signed.jar:${approotcp}${co.prj}-${co.prj.os}-${co.prj.os.arch}-ext-lib_signed.jar:${approotcp}${co.prj}-${co.prj.os}-${co.prj.os.arch}-ext-props_signed.jar:${approotcp}${co.prj}-${co.prj.os}-${co.prj.os.arch}-ext-native_signed.jar:${approotcp}${parent.prj}-${co.prj.os}-${co.prj.os.arch}_signed.jar:${approotcp}${parent.prj}-${co.prj.os}-${co.prj.os.arch}-ext-lib_signed.jar:${approotcp}${parent.prj}-${co.prj.os}-${co.prj.os.arch}-ext-props_signed.jar:${approotcp}${parent.prj}-${co.prj.os}-${co.prj.os.arch}-ext-native_signed.jar"/>
                        <arch name="x86_64"/>
                        <arch name="i386"/>

                        <bundledocument extensions="pgm,ppm,pnm,png,jp2,jpeg,jpg,tiff,tif,gif,bmp,wbmp,pbm"
                            icon="${resources.os.all.dir}/${co.prj}.icns"
                            name="Images"
                            role="Viewer">
                        </bundledocument>


                        <!-- Workaround since the icon parameter for bundleapp doesn't work -->
                        <option value="-Xdock:icon=Contents/Resources/${co.prj}.icns"/>

                        <option value="-Dapple.laf.useScreenMenuBar=true"/>
                        <option value="-Dcom.apple.macos.use-file-dialog-packages=true"/>
                        <option value="-Dcom.apple.macos.useScreenMenuBar=true"/>
                        <option value="-Dcom.apple.mrj.application.apple.menu.about.name=${co.prj}"/>
                        <option value="-Dcom.apple.smallTabs=true"/>
                        <option value="-Dfile.encoding=UTF-8"/>
                        <option value="-Djxa.ecl.io=false"/>
                        <!-- native libraries load through the ECL classloader if only set first /-->
                        <option value="-Djxa.ecl.first=true"/>
                        <option value="-Djxa.debugSys=false"/>
                        <option value="-Djxa.appBundle=true"/>
                        <option value="-Djxa.appRoot=${approotcp}"/>
                        <option value="-Djxa.ecl.res=false"/>
                        <option value="-Dorg.lwjgl.opengl.Display.allowSoftwareOpenGL=false"/>
                        <option value="-Xms${co.prj.os.app.run.minheap}"/>
                        <option value="-Xmx${co.prj.os.app.run.maxheap}"/>
                        <option value="-Dcom.sun.media.imageio.disableCodecLib=false"/>
                        <option value="-Dcom.sun.management.jmxremote.local.only=false"/>
                        <option value="-Dcom.sun.management.jmxremote"/>
                        <option value="-Djava.security.policy=JavaSecurityPolicy"/>
                        <option value="-Dapple.awt.graphics.UseQuartz=true"/>
                        <option value="-Dsun.java2d.translaccel=false"/>
                        <argument value="${co.prj.os.app.run.args}"/>
                </bundleapp>
                <!-- copy the icon -->
                <copy toDir="${application.resources}">
                        <fileset dir="${resources.os.all.dir}">
                                <include name="*.icns"/>
                        </fileset>
                </copy>
        </target>
        <!-- END BUILD PACKAGE /-->

