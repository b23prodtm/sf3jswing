<!DOCTYPE jnlp PUBLIC "-//Sun Microsystems, Inc.//DTD JNLP 1.5//EN" "http://www.netbeans.org/jnlp/DTD/jnlp.dtd">
<jnlp codebase="@PROJECTCODEBASE@api" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext.jnlp">
    <information>
        <title>@PROJECTNAME@ : extensions jars</title>
        <vendor>@COMPANYNAME@</vendor>
        <homepage href="@PROJECTURL@"/>
        <description>@PROJECTDESCRIPTION@</description>
        <icon href="_icons/duke.gif"/>
        <offline-allowed/>
        <shortcut online="true">
            <desktop/>
            <menu submenu="@PROJECTNAME@"/>
        </shortcut>
    </information>
    <security>
        <all-permissions/>
    </security>
    <!-- Below resources properties may be modified to fit your settings //-->
    <resources os="@PROJECTOSNAME@" arch="@PROJECTOSARCH1@">
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext_signed.jar" part="net.sf.jiga.xtended.bin"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-kernel_signed.jar" part="net.sf.jiga.xtended.kernel"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-lib_signed.jar" part="net.sf.jiga.xtended.lib"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-props_signed.jar" part="net.sf.jiga.xtended.props"/>
        <nativelib href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-native_signed.jar" part="net.sf.jiga.xtended.native"/>
    </resources>
    <resources os="@PROJECTOSNAME@" arch="@PROJECTOSARCH2@">
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext_signed.jar" part="net.sf.jiga.xtended.bin"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-kernel_signed.jar" part="net.sf.jiga.xtended.kernel"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-lib_signed.jar" part="net.sf.jiga.xtended.lib"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-props_signed.jar" part="net.sf.jiga.xtended.props"/>
        <nativelib href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-native_signed.jar" part="net.sf.jiga.xtended.native"/>
    </resources>
    <resources os="@PROJECTOSNAME@" arch="@PROJECTOSARCH3@">
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext_signed.jar" part="net.sf.jiga.xtended.bin"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-kernel_signed.jar" part="net.sf.jiga.xtended.kernel"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-lib_signed.jar" part="net.sf.jiga.xtended.lib"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-props_signed.jar" part="net.sf.jiga.xtended.props"/>
        <nativelib href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-native_signed.jar" part="net.sf.jiga.xtended.native"/>
    </resources>
    <resources os="@PROJECTOSNAME@" arch="@PROJECTOSARCH4@">
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext_signed.jar" part="net.sf.jiga.xtended.bin"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-kernel_signed.jar" part="net.sf.jiga.xtended.kernel"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-lib_signed.jar" part="net.sf.jiga.xtended.lib"/>
        <jar download="eager" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-props_signed.jar" part="net.sf.jiga.xtended.props"/>
        <nativelib href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext-native_signed.jar" part="net.sf.jiga.xtended.native"/>
    </resources>
    <component-desc/>
</jnlp>
