    <!-- THIS INSTALL PROCESS IS COMPATIBLE WITH THE OPENSUSE BUILD SERVICE RPM AND DEB, respectively for targets 
    "pre-rpm-build-install" and "pre-deb-build-install"
     TO DO A CUSTOM SANDBOXED BINARY : target "install" on ${build-root.dir}/usr/... 
    OR CALL pre-rpm-build 
    set environment variables : e.g. JXA_BUILDROOT for root directory if current root is not writeable -->
    <condition property="rpm-build-root.dir" value="${env.MYRPM_BUILDROOT}" else="${build-root.dir}">
        <not>
            <isset property="$[env.JXA_BUILDROOT}"></isset>
        </not>
    </condition>
    <!-- LINUX build needs to import the jxakernel library into the current build folder -->
    <target name="pre-install"><mkdir dir="${lib.os.arch}"/><mkdir dir="${resources.os.arch.dir}"/>
        <copy todir="${lib.os.arch}">
            <fileset dir="${build-root.dir}/usr/share/games/sf3jswing-jxakernel/lib">
                <include name="lib-sf3jswing-jxakernel-${co.prj.os}-${co.prj.os.arch}.jar"/>
            </fileset>
        </copy>
        <copy overwrite="true" todir="${resources.os.arch.dir}">
            <fileset dir="${build-root.dir}/usr/share/games/${parent.prj}">
                <include name="*.jar"/>
                <exclude name="api/*"/>
            </fileset>
        </copy>
    </target>

    <property name="MYRPM_BUILDROOT" value="${env.MYRPM_BUILDROOT}"/>
    <property name="rpm-build-root.dir" value="${MYRPM_BUILDROOT}"/>
    
    <target name="pre-rpm-build-install" depends="pre-install, build-jar" description="compile and install into ${rpm-build-root.dir}/usr/share/games/${co.prj}">
        <copy overwrite="true" file="${resources.props.all.dir}/run" tofile="${rpm-build-root.dir}/usr/games/${co.prj}">
            <filterset refid="filtertokens"/>            
        </copy>
        <copy overwrite="true" file="${resources.props.os.all.dir}/${co.prj}.png" todir="${rpm-build-root.dir}/usr/share/pixmaps"/>
        <copy overwrite="true" file="${resources.props.os.all.dir}/${co.prj}.desktop" todir="${rpm-build-root.dir}/usr/share/applications">
            <filterset refid="filtertokens"/>            
        </copy>
        <exec dir="${dist}" executable="chmod">
            <arg line="a+x '${rpm-build-root.dir}/usr/games/${co.prj}'"/>
        </exec>
        <mkdir dir="${rpm-build-root.dir}/usr/share/games/${co.prj}"/>
        <copy overwrite="true" todir="${rpm-build-root.dir}/usr/share/games/${co.prj}">
            <fileset refid="resources.os.all.jars"/>
            <fileset refid="resources.all.jars"/>
            <fileset refid="installed.files"/>
        </copy>
    </target>
    
