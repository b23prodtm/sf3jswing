<!DOCTYPE jnlp PUBLIC "-//Sun Microsystems, Inc.//DTD JNLP 1.5//EN" "http://www.netbeans.org/jnlp/DTD/jnlp.dtd">
<jnlp codebase="@PROJECTCODEBASE@api" href="@ANTPROJECTNAME@-@PROJECTOSNAME@-@PROJECTOSARCH@-ext.jnlp">
     <information>
        <title>@PROJECTNAME@ : extensions jars</title>
        <vendor>@COMPANYNAME@</vendor>
        <homepage href="@PROJECTURL@"/>
        <description>@PROJECTDESCRIPTION@</description>
        <icon href="_icons/duke.gif"/>
        <offline-allowed/>
        <shortcut online="true">
            <desktop/>
            <menu submenu="@PROJECTNAME@"/>
        </shortcut>
    </information>
    <security>
        <all-permissions/>
    </security>
   <!-- Below resources properties may be modified to fit your settings //-->
    <resources>
        <extension href="@ANTPROJECTNAME@-Linux-i386-ext.jnlp">
            <ext-download ext-part="net.sf.jiga.xtended.kernel"/>
            <ext-download ext-part="net.sf.jiga.xtended.native"/>
            <ext-download ext-part="net.sf.jiga.xtended.lib"/>
            <ext-download ext-part="net.sf.jiga.xtended.props"/>
            <ext-download ext-part="net.sf.jiga.xtended.bin"/>
        </extension>
        <extension href="@ANTPROJECTNAME@-Mac-ppc-ext.jnlp">
            <ext-download ext-part="net.sf.jiga.xtended.kernel"/>
            <ext-download ext-part="net.sf.jiga.xtended.native"/>
            <ext-download ext-part="net.sf.jiga.xtended.lib"/>
            <ext-download ext-part="net.sf.jiga.xtended.props"/>
            <ext-download ext-part="net.sf.jiga.xtended.bin"/>
        </extension>
        <extension href="@ANTPROJECTNAME@-Windows-x86-ext.jnlp">
            <ext-download ext-part="net.sf.jiga.xtended.kernel"/>
            <ext-download ext-part="net.sf.jiga.xtended.native"/>
            <ext-download ext-part="net.sf.jiga.xtended.lib"/>
            <ext-download ext-part="net.sf.jiga.xtended.props"/>
            <ext-download ext-part="net.sf.jiga.xtended.bin"/>
        </extension>
    </resources>
    <component-desc/>
</jnlp>