            <arg line="${resources.os.all.dir}/exej.exe"/>
            <arg line="-cfg ${exej.file}.${ant.project.name}"/>
        </exec>
        <exec osfamily="windows" dir="${resources.os.all.dir}" executable="${resources.os.all.dir}/exej.exe">
            <arg line="-cfg ${exej.file}.${ant.project.name}"/>
