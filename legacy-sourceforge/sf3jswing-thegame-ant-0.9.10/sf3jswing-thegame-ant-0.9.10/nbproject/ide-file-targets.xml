<?xml version="1.0" encoding="UTF-8"?>
<project basedir=".." name="sf3jswing-thegame-ant">
    <property file="nbproject/nbjdk.properties"/>
    <property location="${netbeans.user}/build.properties" name="user.properties.file"/>
    <property file="${user.properties.file}"/>
    <import file="jdk.xml"/>
    <import file="../build-${os.name}-${os.arch}.xml"/>
    <import file="../build-jars.xml"/>
    <!-- TODO: edit the following target according to your needs -->
    <!-- (more info: http://www.netbeans.org/kb/articles/freeform-config.html#debugj2se) -->
    <target depends="-jdk-init, clean, jar" name="debug-nb">
        <path id="cp">
            <!-- TODO configure the runtime classpath for your project here: -->
            <fileset dir="${dist}"><include name="**/*.jar"/></fileset>
        </path>
        <nbjpdastart addressproperty="jpda.address" name="sf3jswing-thegame-ant" transport="dt_socket">
            <classpath refid="cp"/>
        </nbjpdastart>
        <!-- TODO configure the main class for your project here: -->
        <java dir="${dist}" classname="net.sf.jiga.xtended.ui.JFCApplet" fork="true">
            <classpath refid="cp"/>
            <arg line="-Dcom.sun.management.jmxremote"/>
            <arg line="-Dcom.sun.management.jmxremote.local.only=false"/>
            <arg line="-vram -antapplet thegame.Sf3 -width ${company.project.os.applet.width} -height ${company.project.os.applet.height}"/>
            <jvmarg line="-Dorg.lwjgl.util.Debug=true"/>
            <jvmarg line="-Djxa.debugSys=false"/>
            <jvmarg line="-Djxa.debugSPM=false"/>
            <jvmarg line="-Djxa.debugRender=true"/>
            <jvmarg line="-Djxa.debugVoid=false"/>
            <jvmarg line="-Djxa.debug=true"/>
            <jvmarg line="-Djxa.nomt=false"/>

            <jvmarg line="-ea"/>
            <jvmarg value="-Xdebug"/>
            <jvmarg value="-Xrunjdwp:transport=dt_socket,address=${jpda.address}"/>
        </java>
    </target>
</project>
