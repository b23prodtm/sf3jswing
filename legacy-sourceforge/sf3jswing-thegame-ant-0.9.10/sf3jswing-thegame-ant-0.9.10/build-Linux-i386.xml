    <import file="build-jars.xml"/>
    
    <target name="pre-install"><copy todir="${lib.os.arch}"><fileset dir="/usr/share/games/sf3jswing-jxakernel/lib"><include name="lib-sf3jswing-jxakernel-${company.project.os.name}-${company.project.os.arch}.jar"/></fileset></copy>
