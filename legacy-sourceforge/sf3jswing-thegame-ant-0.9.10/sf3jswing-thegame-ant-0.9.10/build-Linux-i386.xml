            <fileset dir="/usr/share/games/${company.project.os.extensionsInstaller.base.project.name}">
                <include name="*.jar"/><exclude name="api/*"/>
            </fileset>
        </copy>
    </target>

    <property environment="env"/>
    <property name="MYRPM_BUILDROOT" value="${env.MYRPM_BUILDROOT}"/>
    <property name="rpm-build-root.dir" value="${MYRPM_BUILDROOT}"/>
    
    <target name="pre-rpm-build-install" depends="pre-install, build-jar" description="compile and install into ${rpm-build-root.dir}/usr/share/games/${ant.project.name}">
        <copy overwrite="true" file="${resources.props.all.dir}/run" tofile="${rpm-build-root.dir}/usr/games/${ant.project.name}">
            <filterset refid="filtertokens"/>
        </copy>
        <copy overwrite="true" file="${resources.props.os.all.dir}/${ant.project.name}.png" todir="${rpm-build-root.dir}/usr/share/pixmaps"/>
        <copy overwrite="true" file="${resources.props.os.all.dir}/${ant.project.name}.desktop" todir="${rpm-build-root.dir}/usr/share/applications">
            <filterset refid="filtertokens"/>
        </copy>
        <exec dir="${dist}" executable="chmod">
            <arg line="a+x '${rpm-build-root.dir}/usr/games/${ant.project.name}'"/>
        </exec>
        <mkdir dir="${rpm-build-root.dir}/usr/share/games/${ant.project.name}"/>
        <copy overwrite="true" todir="${rpm-build-root.dir}/usr/share/games/${ant.project.name}">
            <fileset refid="resources.os.all.jars"/>
            <fileset refid="resources.all.jars"/>
            <fileset refid="installed.files"/>
        </copy>
    </target>
    
    <property name="deb-build-root.dir" location="/usr/src/packages/BUILD/debian/${ant.project.name}"/>
    
