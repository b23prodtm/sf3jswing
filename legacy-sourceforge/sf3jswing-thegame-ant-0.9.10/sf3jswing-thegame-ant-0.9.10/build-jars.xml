        <fileset refid="resources.os.all.jars"/>

        <fileset refid="resources.os.arch.jars"/>
        <fileset refid="extension-bundle.jars"/>

    </path>

    <target name="compile" depends="resolve-imagen" description="Compile code">

        <mkdir dir="${src.all}"/>

        <mkdir dir="${src.os}"/>

        <mkdir dir="${bin}"/>

        <mkdir dir="${lib.all}"/>

        <mkdir dir="${lib.os.all}"/>

        <mkdir dir="${lib.os.arch}"/>

        <mkdir dir="${resources.all.dir}"/>

        <mkdir dir="${resources.os.all.dir}"/>

        <mkdir dir="${resources.os.arch.dir}"/>

        <javac nowarn="on"

               proceed="true"

               destdir="${bin}"

               source="17" target="17"

               includeAntRuntime="no"

               classpathref="lib.path"

               debug="${compile.debug}"

               deprecation="true"

               fork="false"><!--compilerarg value="-d32"//-->
            <src>
                <path refid="src.path"/>
            </src>
            <!--compilerarg value="-Xlint:unchecked"></compilerarg//-->

        </javac>

    </target>

    <target name="build-jar" depends="compile, filterLicenseFiles" description="Build jar">

        <mkdir dir="${dist}"/>
        <mkdir dir="${dist}/api"/>

        <mkdir dir="${dist.unsigned}"/>
        <mkdir dir="${dist.unsigned}/api"/>

        <mkdir dir="${resources.props.all.dir}"/>

        <mkdir dir="${resources.props.os.all.dir}"/>

        <mkdir dir="${resources.props.os.arch.dir}"/>

        <mkdir dir="${nativeLib.os.all.dir}"/>

        <mkdir dir="${nativeLib.os.arch.dir}"/>

        <!-- ******* resources files to ${dist} directory ***** -->

        <copy overwrite="true" todir="${dist}">

            <fileset refid="resources.all.jars"/>

            <fileset refid="resources.os.all.jars"/>

            <fileset refid="resources.os.arch.jars"/>
            <mapper type="glob" from="${company.project.os.extensionsInstaller.base.project.name}*" to="api/${company.project.os.extensionsInstaller.base.project.name}*"/>
        </copy>
        <copy overwrite="true" todir="${dist}">
            <fileset refid="resources.all.jars"/>
            <fileset refid="resources.os.all.jars"/>
            <fileset refid="resources.os.arch.jars"/>
            <mapper type="regexp" from="^[^(${company.project.os.extensionsInstaller.base.project.name})](.*)" to="\0"/>

        </copy>

        <copy overwrite="true" file="Manifest" tofile="${Manifest.file}">
            <filterset refid="filtertokens"/>
        </copy>

        <jar jarfile="${dist.unsigned}/${jarfile}"

             basedir="${bin}"

             manifest="${Manifest.file}"

             update="true"

             compress="true">
            <metainf dir=".">
                <patternset refid="license.files"/>
            </metainf>
        </jar>

        <copy overwrite="true" file="Manifest-ext-lib" tofile="${Manifest-extension-lib.file}">
            <filterset refid="filtertokens"/>
        </copy>

        <jar jarfile="${dist.unsigned}/${extension-lib-jarfile}"

             manifest="${Manifest-extension-lib.file}"

             update="true"

             compress="true">
            <metainf dir=".">
                <patternset refid="license.files"/>
            </metainf>

            <!-- Merge library jars into final jar file -->

            <zipgroupfileset refid="lib.all.jars"/>

            <zipgroupfileset refid="lib.os.all.jars"/>

            <zipgroupfileset refid="lib.os.arch.jars"/>

        </jar>
        <copy overwrite="true" file="Manifest-ext-props" tofile="${Manifest-extension-props.file}">
            <filterset refid="filtertokens"/>
        </copy>

        <jar jarfile="${dist.unsigned}/${extension-props-jarfile}"

             manifest="${Manifest-extension-props.file}"

             update="true"

             compress="true">
            <metainf dir=".">
                <patternset refid="license.files"/>
            </metainf>

            <!-- ****** zip resources ******  -->

            <fileset refid="resources.props.all.files"/>

            <fileset refid="resources.props.os.all.files"/>

            <fileset refid="resources.props.os.arch.files"/>

        </jar>

        <copy overwrite="true" file="Manifest-ext-native" tofile="${Manifest-extension-native.file}">
            <filterset refid="filtertokens"/>
        </copy>

        <jar jarfile="${dist.unsigned}/${extension-native-jarfile}"

             manifest="${Manifest-extension-native.file}"

             update="true"

             compress="true">
            <metainf dir=".">
                <patternset refid="license.files"/>
            </metainf>

            <!-- Merge library jars into final jar file -->

            <fileset refid="nativeLib.os.all.files"/>

            <fileset refid="nativeLib.os.arch.files"/>

        </jar>
        
        <copy overwrite="true" file="${resources.all.dir}/extension.properties" tofile="${resources.props.os.arch.dir}/net/sf/jiga/xtended/kernel/extension.properties">
            <filterset refid="filtertokens"/>
        </copy>
        <copy overwrite="true" file="${lib.all}/lib-Manifest-ext-kernel" tofile="${Manifest-extension-kernel.file}">
            <filterset refid="filtertokens"/>
        </copy>
        <jar jarfile="${dist.unsigned}/api/${extension-kernel-jarfile}" manifest="${Manifest-extension-kernel.file}" filesetmanifest="merge"
             
             update="true"
             
             compress="true">
            <fileset dir="${resources.props.os.arch.dir}" includes="net/sf/jiga/xtended/kernel/extension.properties"/>
            <zipfileset src="${lib.os.arch}/${extension-bundle.jarfile}" excludes="net/sf/jiga/xtended/kernel/extension.properties"></zipfileset>
        </jar>

    </target>



    <!-- See if we already have a private key for this user in ~/.keystore.  -->

    <!-- Note: This tests for an output string of "does not exist", this

             assumes the locale is set to English and will not work for Spanish

             or other languages. -->

    <target name="checkforkey" depends="build-jar" description="Generate private key">

        <exec executable="/usr/bin/keytool" os="Mac OS X">

            <redirector outputproperty="keytool.findalias.out"/>

            <arg value="-list"/>

            <arg value="-alias"/>

            <arg value="${username}"/>

            <arg value="-storepass"/>

            <arg value="${storepass}"/>
            <arg value="-storetype"/>
            <arg value="${keystore-type}"/>
            <arg value="-keystore"/>
            <arg value="${keystore}"/>

        </exec>

        <exec executable="${java.home}/../bin/keytool.exe" os="Windows">

            <redirector outputproperty="keytool.findalias.out"/>

            <arg value="-list"/>

            <arg value="-alias"/>

            <arg value="${username}"/>

            <arg value="-storepass"/>

            <arg value="${storepass}"/>
            <arg value="-storetype"/>
            <arg value="${keystore-type}"/>
            <arg value="-keystore"/>
            <arg value="${keystore}"/>

        </exec>

        <exec executable="keytool" os="Linux">

            <redirector outputproperty="keytool.findalias.out"/>

            <arg value="-list"/>

            <arg value="-alias"/>

            <arg value="${username}"/>

            <arg value="-storepass"/>

            <arg value="${storepass}"/>
            <arg value="-storetype"/>
            <arg value="${keystore-type}"/>
            <arg value="-keystore"/>
            <arg value="${keystore}"/>

        </exec>

        <condition property="createPrivateKey">

            <or>
                <contains string="${keytool.findalias.out}" substring="introuvable"></contains>
                <contains string="${keytool.findalias.out}" substring="does not exist">

                      

                </contains>
            </or>

        </condition>

    </target>



    <!-- If createPrivateKey is set we need to call genkey.  -->

    <target name="genkey" depends="checkforkey" if="createPrivateKey">

        <genkey validity="3650" alias="${username}" storepass="${storepass}" keystore="${keystore}" storetype="${keystore-type}">

            <dname>

                <param name="CN" value="${username}"/>

                <param name="OU" value="${company.project.name}"/>

                <param name="O"  value="${company.name}"/>

                <param name="C"  value="${company.country.id}"/>

            </dname>

        </genkey>

    </target>



    <!-- Sign the JAR with the key generated above. -->

    <target name="jar" depends="genkey" description="Sign JAR file">


        <signjar jar="${dist.unsigned}/${jarfile}"

                 alias="${username}"

                 storepass="${storepass}"

                 keystore="${keystore}" storetype="${keystore-type}"

                 signedjar="${dist}/${signed.jarfile}"/>

        <signjar jar="${dist.unsigned}/${extension-native-jarfile}"

                 alias="${username}"

                 storepass="${storepass}"

                 keystore="${keystore}" storetype="${keystore-type}"

                 signedjar="${dist}/${extension-native-signed.jarfile}"/>
        <signjar jar="${dist.unsigned}/api/${extension-kernel-jarfile}" alias="${username}" storepass="${storepass}" keystore="${keystore}" storetype="${keystore-type}" signedjar="${dist}/api/${extension-kernel-signed.jarfile}"/>
        <signjar jar="${dist.unsigned}/${extension-lib-jarfile}"

                 alias="${username}"

                 storepass="${storepass}"

                 keystore="${keystore}" storetype="${keystore-type}"

                 signedjar="${dist}/${extension-lib-signed.jarfile}"/>

        <signjar jar="${dist.unsigned}/${extension-props-jarfile}"

                 alias="${username}"

                 storepass="${storepass}"

                 keystore="${keystore}" storetype="${keystore-type}"

                 signedjar="${dist}/${extension-props-signed.jarfile}"/>



    </target>
    <target name="DO-applet" depends="clean, jar" description="Builds applet in dist folder (param's are in project.html file)">
        <!-- run file //-->
        <copy overwrite="true" file="${ant.project.name}.html" tofile="${dist}/${html.file}">
            <filterset refid="filtertokens">
            </filterset>
        </copy>
        <copy overwrite="true" file="${ant.project.name}.php" tofile="${dist-root}/${ant.project.name}.php">
            <filterset refid="filtertokens"/>
        </copy>
        <copy overwrite="true" file="${resources.props.all.dir}/run.jnlp" tofile="${dist}/${jnlp.file}">
            <filterset refid="filtertokens"/>
        </copy>
        <copy overwrite="true" file="${resources.props.all.dir}/run-all.jnlp" tofile="${dist}/${jnlp.all.file}">
            <filterset refid="filtertokens"/>
        </copy>
        <copy file="${policy.file}" todir="${dist}"/>
        <checksum algorithm="MD5">
            <fileset dir="${dist}">
                <exclude name="**/*.MD5"/>
            </fileset>
        </checksum>

    </target>
    <target name="run-applet" depends="jar" description="Run applet in appletviewer (param's are in project.html file)">
        <!-- run file //-->
        <copy overwrite="true" file="${ant.project.name}.html" tofile="${dist}/appletViewer-${html.file}">          
            <filterset>
                <filter token="${company.project.codebase.token}" value="."/>
            </filterset>
            <filterset refid="filtertokens"/>
        </copy>
        <copy overwrite="true" file="${ant.project.name}.php" tofile="${dist-root}/${ant.project.name}.php">
            <filterset refid="filtertokens"/>
        </copy>
        <copy overwrite="true" file="${resources.props.all.dir}/run.jnlp" tofile="${dist}/${jnlp.file}">
            <filterset refid="filtertokens"/>
        </copy>
        <copy overwrite="true" file="${resources.props.all.dir}/run-all.jnlp" tofile="${dist}/${jnlp.all.file}">
            <filterset refid="filtertokens"/>
        </copy>
        <copy file="${policy.file}" todir="${dist}"/>

        <exec osfamily="Windows" dir="${dist}" executable="${jdk.home}\bin\appletviewer.exe">

            <arg line="'appletViewer-${html.file}'"/>
            <arg line="-J-Djava.security.policy=JavaSecurityPolicy"/>

            <!-- //--><!-- JConsole can be activated to monitor the project //-->

            <arg line ="-J-Dcom.sun.management.jmxremote"/>

            <arg line="-J-Dcom.sun.management.jmxremote.local.only=false"/>


            <arg line="-J-Dorg.lwjgl.util.Debug=false"/>
            <arg line="-J-Djxa.debugSys=false"/>
            <arg line="-J-Djxa.debugRender=true"/>

            <arg line="-J-ea"/>
            <arg line="${company.project.os.appletviewer.args}"/>

        </exec>

        <exec os="Mac OS X" dir="${dist}" executable="/usr/bin/appletviewer">

            <arg line="'appletViewer-${html.file}'"/>

            <arg line="-J-Djava.security.policy=JavaSecurityPolicy"/>

            <!-- //--><!-- JConsole can be activated to monitor the project //-->

            <arg line ="-J-Dcom.sun.management.jmxremote"/>

            <arg line="-J-Dcom.sun.management.jmxremote.local.only=false"/>
            <arg line="-J-Dorg.lwjgl.util.Debug=false"/>
            <arg line="-J-Djxa.debugSys=false"/>
            <arg line="-Djxa.debugRender=true"/>

            <arg line="-J-ea"/>
            <arg line="${company.project.os.appletviewer.args}"/>
        </exec>

        <exec os="Linux" dir="${dist}" executable="${jdk.home}/bin/appletviewer">

            <arg line="'appletViewer-${html.file}'"/>

            <!--arg line="-J-Djava.library.path=."//-->

            <arg line="-J-Djava.security.policy=JavaSecurityPolicy"/>

            <!-- //--><!-- JConsole can be activated to monitor the project //-->

            <arg line ="-J-Dcom.sun.management.jmxremote"/>

            <arg line="-J-Dcom.sun.management.jmxremote.local.only=false"/>
            <arg line="-J-Dorg.lwjgl.util.Debug=false"/>
            <arg line="-J-Djxa.debugSys=false"/>

            <arg line="-J-ea"/>
            <arg line="${company.project.os.appletviewer.args}"/>
        </exec>


    </target>

    <target name="run" depends="jar" description="Run application">

        <copy overwrite="true" file="${resources.props.all.dir}/run.jnlp" tofile="${dist}/${jnlp.file}">
            <filterset refid="filtertokens"/>
        </copy>
        <copy overwrite="true" file="${resources.props.all.dir}/run-all.jnlp" tofile="${dist}/${jnlp.all.file}">
            <filterset refid="filtertokens"/>
        </copy>

        <copy overwrite="true" file="${resources.props.all.dir}/run" tofile="${dist}/${run.file}">
            <filterset refid="filtertokens"/>
        </copy>

        <exec dir="${dist}" executable="cmd.exe" osfamily="Windows">
            <arg line="rename"/>
            <arg file="${run.file}"/>
            <arg file="${run.file}.bat"/>
        </exec>
        <exec osfamily="Windows" dir="${dist}" executable="${java.home}\bin\java.exe">

            <!-- //--><!-- JConsole can be activated to monitor the project //-->
            <!--arg line="-Djava.library.path=."/-->

            <arg line="-Dcom.sun.management.jmxremote"/>

            <arg line="-Dcom.sun.management.jmxremote.local.only=false"/>


            <arg line="-Dorg.lwjgl.util.Debug=true"/>
            <arg line="-Djxa.debugSys=false"/>
            <arg line="-Djxa.debugRender=true"/>
            <arg line="-Djxa.debug=true"/>
            <arg line="-ea"/>
            <arg line="${company.project.os.application.run.params}"/>
            <arg line="-classpath '${company.project.os.application.run.classpath}'"/>
            <!--arg line="-classpath '${signed.jarfile}'"//-->
            <arg line="${company.project.os.application.run.main}"/>
            <arg line="${company.project.os.application.run.args}"/>

        </exec>

        <exec dir="${dist}" command="mv '${run.file}' '${run.file}.sh'" os="Mac OS X"/>

        <exec dir="${dist}" command="chmod a+x '${run.file}.sh'" os="Mac OS X"/>

        <exec os="Mac OS X" dir="${dist}" executable="/usr/bin/java">

            <!-- //--><!-- JConsole can be activated to monitor the project //-->

            <arg line ="-Dcom.sun.management.jmxremote"/>

            <arg line="-Dcom.sun.management.jmxremote.local.only=false"/>

            <arg line="-Dorg.lwjgl.util.Debug=false"/>
            <arg line="-Djxa.debugSys=false"/>

            <arg line="-ea"/>

            <arg line="${company.project.os.application.run.params}"/>
            <arg line="-classpath '${company.project.os.application.run.classpath}'"/>
            <!--arg line="-classpath '${signed.jarfile}'"//-->
            <arg line="${company.project.os.application.run.main}"/>
            <arg line="${company.project.os.application.run.args}"/>

        </exec>

        <exec dir="${dist}" command="mv '${run.file}' '${run.file}.sh'" os="Linux"/>

        <exec dir="${dist}" command="chmod a+x '${run.file}.sh'" os="Linux"/>

        <exec os="Linux" dir="${dist}" executable="${jdk.home}/bin/java">

            <!--arg line="-Djava.library.path=."//-->

            <!-- //--><!-- JConsole can be activated to monitor the project //-->

            <arg line="-Dcom.sun.management.jmxremote"/>

            <arg line="-Dcom.sun.management.jmxremote.local.only=false"/>

            <arg line="-Dorg.lwjgl.util.Debug=false"/>
            <arg line="-Djxa.debugSys=false"/>

            <arg line="-ea"/>

            <arg line="${company.project.os.application.run.params}"/>
            <arg line="-classpath '${company.project.os.application.run.classpath}'"/>
            <!--arg line="-classpath '${signed.jarfile}'"//-->
            <arg line="${company.project.os.application.run.main}"/>
            <arg line="${company.project.os.application.run.args}"/>

        </exec>

    </target>


    <target name="clean" description="Remove build and dist directories">

        <delete dir="${bin}"/>

        <delete dir="${dist.os}"/>

    </target>
    <target name="DO-clean-root" depends="clean" description="Remove all build and dist directories">
        <delete dir="${dist-root}"/>
    </target>

    <target name="javadoc" description="Generate javadoc">
        <delete dir="${dist-root}/doc"/>
        <javadoc docencoding="UTF-8" windowtitle="JavaDoc : ${company.project.name}" classpathref="lib.path"

                 use="true" author="true" private="false"

                 additionalparam=""

                 sourcepathref="src.path"

                 destdir="${dist-root}/doc"

        >

            <link href="http://sf3jswing.sourceforge.net/doc/"/>
            <link href="http://sf3jswing.sourceforge.net/doc-kernel/"/>
            <arg line="-tag default:cmf:'Default init. value :'"/>

            <arg line="-tag discussion:a:'Discussion topic :'"/>

            <doctitle><![CDATA[${company.name}/<a target='_blank' href='${company.project.url}'>${company.project.name} (${company.project.version.spec})</a>]]>

            </doctitle>
            
            <bottom><![CDATA[

            <i>rev. ${company.project.version.impl} - Copyright &#169; ${company.project.years} <a target='_blank' href='${company.url}'>${company.name}</a>

            All rights reserved under the ${company.project.license} terms and conditions. <b>Free your project !</b></i>
            <br>This software includes the LightWeight Java Gaming Library API - <a target='_blank' href='http://www.lwjgl.org'>LWJGL.org</a>.

            <hr><center><a target='_blank'href='http://sourceforge.net'><img src='http://sflogo.sourceforge.net/sflogo.php?group_id=173003&amp;type=4' width='125' height='37' border='0' alt='SourceForge.net Logo'/></a></center>]]>

            </bottom>

        </javadoc>

    </target>

    <target name="DO-src-pack" depends="filterLicenseFiles" description="Build source tar.gz">
        <mkdir dir="${tar.dir}"/>
        <copy overwrite="true" todir="${tar.dir}">
            <filterset refid="filtertokens"/>
            <fileset refid="linux-package-build-files"/>       
            <fileset dir="${resources.all.dir}">
                <patternset refid="license.files"/>
            </fileset>
            <filterset refid="filtertokens"/>
        </copy>
        <tar longfile="gnu"
             compression="gzip"
             destfile="${tar.dir}/${tar.name}.tar.gz">
            <tarfileset refid="tar.files"/>
        </tar>
    </target>
    <target depends="DO-src-pack" name="CBRelease" description="Upload src files to CB as tar.gz">
        <CBRelease file="${tar.dir}/${tar.name}.tar.gz"/>
    </target>
</project>
