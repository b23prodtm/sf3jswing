    <import file="build-jars.xml" as="${co.prj.os}-${co.prj.os.arch}"/>
    
    <!-- BUILD APPLICATION PACKAGE /-->
    
    <property name="apple.appstub" location="${resources.os.all.dir}/JavaApplicationStub"/>
    <property name="application" location="${dist}/${co.prj}.app"/>
    <!--location="/System/Library/Frameworks/JavaVM.framework/Resources/MacOS/JavaApplicationStub"/-->
    <property name="application.macos" location="${application}/Contents/MacOS"/>
    <property name="application.macos.stub" location="${application.macos}/${co.prj}"/>
    <property name="application.resources" location="${application}/Contents/Resources"/>
    <property name="application.resources.java" location="${application}/Contents/Resources/Java"/>
    
    <target name="install" depends="clean, jar" description="create application .app package">
        <mkdir dir="${application.resources.java}"/>
        <mkdir dir="${application.macos}"/>
        <!-- copy jars /-->
        <copy toDir="${application.resources.java}">
            <fileset dir="${dist}">
                <include name="*.jar"/>
            </fileset>            
        </copy>
        <copy toDir="${application.resources.java}/api">
            <fileset dir="${dist}/api">
                <include name="*.jar"/>
            </fileset>
        </copy>
        <!-- copy application stub -->
        <copy file="${apple.appstub}" toFile="${application.macos}/${co.prj}"/>
        <!-- fix stub permissions -->
        <exec executable="/bin/chmod">
            <arg line="755 '${application.macos.stub}'"/>
        </exec>
        <!-- copy and configure Info.plist -->
        <copy overwrite="true" file="${resources.os.all.dir}/Info.plist" toFile="${application}/Contents/Info.plist">
            <filterset refid="filtertokens"/>
        </copy>
        <!-- copy the icon -->
        <copy toDir="${application.resources}">
            <fileset dir="${resources.os.all.dir}">
                <include name="*.icns"/>
            </fileset>
        </copy>
    </target>

    <!-- END BUILD PACKAGE /-->

